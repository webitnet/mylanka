# ── Database (Supabase) ─────────────────────────────────
# Pooled (Transaction mode, port 6543) — used by Prisma Client at runtime
DATABASE_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct (port 5432) — used by Prisma Migrate for DDL
DIRECT_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── App ─────────────────────────────────────────────────
# Base URL used by:
#   - payment-provider callback URLs (server_url, webHookUrl, redirectUrl)
#   - admin order links in Telegram notifications
#   - bot/start "Open store" deep links (must be HTTPS in prod — see TELEGRAM_LINK_BASE_URL)
# Dev: http://localhost:3000 (real webhooks need a public tunnel like ngrok)
# Prod: https://mylanka.com.ua
PUBLIC_BASE_URL="http://localhost:3000"

# ── NextAuth ────────────────────────────────────────────
# Prod: https://mylanka.com.ua (same as PUBLIC_BASE_URL).
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ── Payments ────────────────────────────────────────────
# LiqPay: sandbox_* prefix toggles sandbox mode automatically.
LIQPAY_PUBLIC_KEY=""
LIQPAY_PRIVATE_KEY=""
# Hide LiqPay from checkout UI ("false" → only Monobank + COD).
NEXT_PUBLIC_LIQPAY_ENABLED="false"

# Monobank Acquiring (X-Token from https://api.monobank.ua/acquiring)
MONOBANK_TOKEN=""

# ── Telegram ────────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=""
# Public-facing bot username (no @)
TELEGRAM_BOT_USERNAME=""
# Supergroup or DM chat ID for admin notifications (e.g. "-100..." for supergroup)
TELEGRAM_ADMIN_CHAT_ID=""
# Override PUBLIC_BASE_URL for bot inline-keyboard links when running dev
# against localhost (Telegram rejects non-HTTPS in buttons).
TELEGRAM_LINK_BASE_URL=""
# (Phase 5 future) Mini App URL — used if you embed a launch button in messages.
TELEGRAM_WEBAPP_URL=""

# ── Shipping ────────────────────────────────────────────
# Nova Poshta API key — register at https://novaposhta.ua
NOVAPOSHTA_API_KEY=""

# ── Storage (Cloudflare R2, S3-compatible) ──────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public URL of the bucket. Either:
#   - the default <hash>.r2.dev URL, or
#   - a custom domain pointing at the bucket (cdn.mylanka.com.ua).
R2_PUBLIC_URL=""

# ── Search (optional) ───────────────────────────────────
MEILISEARCH_HOST=""
MEILISEARCH_API_KEY=""

# ── Monitoring (optional) ───────────────────────────────
# SENTRY_DSN=""

# ── Seed (dev only) ─────────────────────────────────────
SEED_ADMIN_EMAIL="admin@mylanka.local"
SEED_ADMIN_PASSWORD="changeme"
